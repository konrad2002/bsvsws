{
  "name": "@bsv-sws/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared domain types, constants and framework-free utilities",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
