# ---------------------------------------------------------------------------
# BSV-SWS – environment configuration
# Copy to `.env` for local development:  cp .env.example .env
# `.env` is git-ignored. Test/production values live in deployment secrets.
# Values below are SAFE PLACEHOLDERS for local use only.
# ---------------------------------------------------------------------------

# --- PostgreSQL (only Directus connects to it) -----------------------------
POSTGRES_DB=directus
POSTGRES_USER=directus
POSTGRES_PASSWORD=change-me-local-db-password

# --- Directus --------------------------------------------------------------
# Generate a secret with: openssl rand -hex 32
DIRECTUS_SECRET=change-me-local-directus-secret
DIRECTUS_PORT=8055
# Public URL of Directus as seen by browsers
DIRECTUS_PUBLIC_URL=http://localhost:8055
# Bootstrap admin (created on first start of an empty database)
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me-local-admin-password
# Static token for the bootstrap admin – LOCAL DEVELOPMENT ONLY.
# Used by AI agents / scripts to call the local Directus API (docs/DIRECTUS_API.md).
# Leave empty in test/production.
DIRECTUS_ADMIN_TOKEN=change-me-local-admin-token
# Admin token used by `pnpm directus:apply` in deployed environments (falls back to
# DIRECTUS_ADMIN_TOKEN locally). Leave empty locally.
DIRECTUS_SETUP_TOKEN=
# Directus licence key (Open Innovation Grant, format DXXXX-XXXXX-XXXXX-XXXXC).
# Optional locally if the key was entered in Studio. Never commit the real key.
DIRECTUS_LICENSE_KEY=

# --- SMTP – used by Directus and the API -------------------------------------
# Local: Mailpit (started by `pnpm stack:up`, UI http://localhost:8025).
# Test/production: IONOS, e.g. SMTP_HOST=smtp.ionos.de, SMTP_PORT=587 (STARTTLS) or 465 + SMTP_SECURE=true.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="BSV-SWS <no-reply@bsv-sws.de>"
# SMTP host as seen from inside Docker (Directus, API image). Locally the Mailpit service name.
DIRECTUS_SMTP_HOST=mailpit

# --- Fastify API ------------------------------------------------------------
API_PORT=4000
LOG_LEVEL=info
# Directus URL as reachable from the API (host process → published port)
DIRECTUS_URL=http://localhost:8055
# Secret for HMACs of verification codes (min. 32 chars). REQUIRED. openssl rand -hex 32
APP_SECRET=change-me-local-app-secret-min-32-characters
# Public website URL used in email links
WEB_PUBLIC_URL=http://localhost:3000
# Validity of invitation links in days
INVITATION_TTL_DAYS=14
# Token of the restricted Fastify service account. REQUIRED. `pnpm directus:apply`
# writes it to the service user. Generate with: openssl rand -hex 32
DIRECTUS_SERVICE_TOKEN=change-me-local-service-token-min-32-characters

# --- Next.js web --------------------------------------------------------------
WEB_PORT=3000
# Fastify URL as reachable from the Next.js server
API_URL=http://localhost:4000
# Session cookies with the Secure flag (default: true in production, false otherwise)
SESSION_COOKIE_SECURE=

# --- Local dev seed (pnpm directus:seed) ------------------------------------
# Password of the local test accounts (min. 10 chars). Local only.
DEV_SEED_PASSWORD=change-me-local-seed-password
