# ---------------------------------------------------------------------------
# BSV-SWS – deployed environment (test OR production) on the VPS.
# Copy to <deploy dir>/.env (chmod 600, owner = deploy user) and fill in, e.g.
# test/dev: /home/konrad/docker/bsv/dev/.env, production: /opt/bsv-sws/production/.env
# Every value must differ between test and production (spec §14.3/§14.4).
# Generate secrets with: openssl rand -hex 32
# This file lives only on the server – never in git or GitHub.
# ---------------------------------------------------------------------------

# --- Images (IMAGE_TAG is set per deploy by deploy.sh in image.env) ---------
IMAGE_REGISTRY=ghcr.io/konrad2002/bsv-sws

# --- Reverse proxy -------------------------------------------------------------
# A) nginx runs as a Docker container (dev host): web and Directus join its network
#    under <PROXY_ALIAS>-web:3000 and <PROXY_ALIAS>-cms:8055, no host ports
#    (compose.proxy.yml; nginx example: nginx/bsv-dev.conf.example).
PROXY_NETWORK=
PROXY_ALIAS=bsv-dev
# B) nginx on the host: leave PROXY_NETWORK empty; ports are published on 127.0.0.1
#    (must not collide with other services, e.g. dev 3100/8155, production 3000/8055).
WEB_PORT=3000
DIRECTUS_PORT=8055

# --- Public URLs --------------------------------------------------------------
# dev: https://bsv.konrad2002.de / https://bsv-cms.konrad2002.de
WEB_PUBLIC_URL=https://bsv-sws.de
DIRECTUS_PUBLIC_URL=https://cms.bsv-sws.de

# --- PostgreSQL (internal to the stack) ---------------------------------------
POSTGRES_DB=directus
POSTGRES_USER=directus
POSTGRES_PASSWORD=

# --- Directus -----------------------------------------------------------------
DIRECTUS_SECRET=
# Bootstrap administrator, created on the very first start of an empty database.
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
# Static admin token for the tools job (directus:apply, migration). Set it once
# BEFORE the first start: Directus assigns it to the bootstrap admin. Rotate by
# changing the admin's token in Studio and here.
DIRECTUS_ADMIN_TOKEN=
DIRECTUS_SETUP_TOKEN=${DIRECTUS_ADMIN_TOKEN}
# Open Innovation Grant licence key (one activation per environment).
DIRECTUS_LICENSE_KEY=

# --- Fastify API ----------------------------------------------------------------
APP_SECRET=
# Written to the service account by `apply` on every deploy.
DIRECTUS_SERVICE_TOKEN=
INVITATION_TTL_DAYS=14
LOG_LEVEL=info

# --- SMTP (IONOS) – used by Directus and the API ------------------------------
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
# 587 = STARTTLS (SMTP_SECURE=false), 465 = implicit TLS (SMTP_SECURE=true)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Must be an address the IONOS mailbox may send as (SPF/DKIM of the domain).
EMAIL_FROM="BSV-SWS <no-reply@bsv-sws.de>"
# Do NOT set DIRECTUS_SMTP_HOST here (local Mailpit override only).

# --- Migration (docs/migration.md) --------------------------------------------
JOOMLA_URL=https://bsv-sws.de
