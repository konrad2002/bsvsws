# nginx example for ONE environment (copy per environment and adjust names/ports):
#   production: bsv-sws.de + cms.bsv-sws.de        → web 127.0.0.1:3000, Directus 127.0.0.1:8055
#   test:       <test-domain> + cms.<test-domain>  → web 127.0.0.1:3100, Directus 127.0.0.1:8155
# TLS certificates e.g. via certbot (`certbot --nginx -d bsv-sws.de -d www.bsv-sws.de -d cms.bsv-sws.de`).
#
# IMPORTANT: X-Forwarded-For is OVERWRITTEN with the client address (not appended).
# The app uses the first entry for rate limiting (spec §11.3); appending would let
# clients spoof it.

# --- HTTP → HTTPS -----------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name bsv-sws.de www.bsv-sws.de cms.bsv-sws.de;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# --- www → apex -------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.bsv-sws.de;
    ssl_certificate     /etc/letsencrypt/live/bsv-sws.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bsv-sws.de/privkey.pem;
    return 301 https://bsv-sws.de$request_uri;
}

# --- Website (Next.js) ------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name bsv-sws.de;
    ssl_certificate     /etc/letsencrypt/live/bsv-sws.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bsv-sws.de/privkey.pem;

    # Event files / images / logos are uploaded through the app (largest: 20 MB event files).
    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        # $http_host keeps a non-default port (Next.js Server Actions compare it with Origin).
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        # Streaming (React Server Components / Suspense) must not be buffered.
        proxy_buffering off;
        proxy_read_timeout 60s;
    }
}

# --- Directus Studio (federation users and administrators only) -------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name cms.bsv-sws.de;
    ssl_certificate     /etc/letsencrypt/live/bsv-sws.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bsv-sws.de/privkey.pem;

    # Editor uploads (images, PDFs) in Studio.
    client_max_body_size 50m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
        proxy_pass http://127.0.0.1:8055;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
